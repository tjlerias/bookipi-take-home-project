# Copy to .env and adjust. All values here are safe local defaults.

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
POSTGRES_DB=flashsale

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000

# Sale configuration (ISO 8601 UTC). Leave SALE_START/SALE_END unset to
# default to "now" and "now + 1 hour".
SALE_ID=launch-1
SALE_START=
SALE_END=
SALE_STOCK=100

# Set to false for the stress test profile so the load generator is not throttled
RATE_LIMIT_ENABLED=true
