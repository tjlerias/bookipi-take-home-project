# Copy this file to .env and adjust the values as needed.
# The defaults below are intended for local development only.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
POSTGRES_DB=flashsale

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Sale
# -----------------------------------------------------------------------------
# Only the sale window is configurable. The sale itself (id, name, products,
# stock, per-user limit) is defined in db/seed-data.ts.

# Sale window in ISO 8601 format.
# If omitted:
#   SALE_START defaults to the current time.
#   SALE_END defaults to 24 hours after SALE_START.
#
# Example:
#   SALE_START=2026-09-10T12:00:00Z
#   SALE_END=2026-09-10T13:00:00Z
SALE_START=
SALE_END=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# Enables API rate limiting.
# Set to false when running stress tests so the load generator is not throttled.
RATE_LIMIT_ENABLED=true
